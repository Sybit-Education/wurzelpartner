# Public reads: middleware origin only, without /api. No API key required.
VITE_MIDDLEWARE_API_URL=http://localhost:3000

# Legacy login and writes still access NocoDB directly.
# VITE_ values are public in the browser. Never use an administrative key.
VITE_NOCODB_API_URL=http://localhost:8080
VITE_NOCODB_API_KEY=YOUR_RESTRICTED_API_KEY
