    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "leaflet.path.drag": "^0.0.6",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.2.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
