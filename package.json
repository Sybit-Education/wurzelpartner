    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "~1.90.0",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.5.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.90.0",
    "postcss": "^8.5.6",
    "prettier": "3.9.10",
    "sass-embedded": "^1.108.0",
