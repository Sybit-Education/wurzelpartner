# Server-only configuration. Copy to .env.middleware and protect with chmod 600.
# Leave real secrets out of VITE_* variables and Git.
NOCODB_API_URL=http://127.0.0.1:8080
NOCODB_API_TOKEN=
NOCODB_BASE_ID=
NOCODB_TABLE_PREFIX=
JWT_SECRET=
JWT_EXPIRES_IN=1d
AUTH_PROVIDER=local
CORS_ORIGINS=http://localhost:5173
PORT=3000
LOG_LEVEL=info

# Production only: official Git release tag, e.g. nocodb-middleware-vX.Y.Z.
# v0.8.1 DOES NOT contain the required public-read routes. No safe default yet.
MIDDLEWARE_RELEASE=
# Published on 127.0.0.1 only; put an HTTPS reverse proxy in front.
MIDDLEWARE_HTTP_PORT=3000